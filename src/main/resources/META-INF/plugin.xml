<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.zarechenskiy.widthseparator</id>
    <name>Width Separator</name>
    <vendor>zarechenskiy</vendor>
    <description><![CDATA[
        <p><b>Width Separator</b> shows a vertical guide at a file-specific column in test data files.</p>
        <p>The guide is shown for <code>.input</code> and <code>.output</code> files that declare the column with a
        <code>// MAX_WIDTH N</code> comment on its own line, for example <code>// MAX_WIDTH 100</code>.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- Restricts the plugin to IntelliJ IDEA (Community and Ultimate); other IDEs do not provide this module. -->
    <depends>com.intellij.modules.idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <editorFactoryListener implementation="com.github.zarechenskiy.widthseparator.MaxWidthGuideEditorListener"/>
    </extensions>
</idea-plugin>
